# ローカル開発で `.env` を読み込むには `cargo make dev` / `cargo make watch` を使うか、
# `SOUKOU_DEVELOPMENT_MODE=1 cargo run` のように起動時の環境変数で指定してください。

# Web 側の Soukou サイト URL。
# 認証開始時の遷移先として使われます。通常は本番 URL のままで問題ありません。
SOUKOU_SITE_URL=https://soukou.dev

# Supabase プロジェクト URL。
# 例: https://your-project-ref.supabase.co
SOUKOU_SUPABASE_URL=

# Supabase の publishable / anon key。
# クライアントから使う公開可能なキーを設定してください。service_role key は設定しないでください。
SOUKOU_SUPABASE_PUBLISHABLE_KEY=

# ネイティブアプリの認証コールバック URL scheme。
# `soukou://auth/callback` の scheme 部分です。通常は `soukou` のままで問題ありません。
SOUKOU_AUTH_CALLBACK_SCHEME=soukou

# 任意: Lindera の外部辞書パス。
# embedded-ipadic feature を使わないビルドや、独自辞書を使う場合に辞書ディレクトリのパスを設定します。
# SOUKOU_LINDERA_DICTIONARY_PATH=/path/to/lindera/dictionary

# 任意: 開発用フラグ。
# `cargo make dev` / `cargo make watch` では Makefile.toml から自動設定されます。
# SOUKOU_DEVELOPMENT_MODE=1
# SOUKOU_DEVELOPMENT_WATCH_MODE=1
