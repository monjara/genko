[
  {
    "bindings": {
      "ctrl-q": "menu::Quit",
      "ctrl-,": "menu::OpenSettings",
      "ctrl-o": "menu::OpenFile",
      "ctrl-s": "menu::SaveFile",
      "ctrl-shift-o": "workspace::OpenWorkspace",
      "ctrl-shift-e": "workspace::ToggleWorkspacePane",
      "ctrl-alt-u": "menu::CheckForUpdates",
      "ctrl-alt-a": "menu::RegisterAccount",
      "ctrl-alt-shift-a": "menu::SignOut",
      "ctrl-shift-t": "menu::ExportTxt",
      "ctrl-shift-w": "menu::ExportWord",
      "ctrl-shift-p": "menu::ExportEpub",
      "ctrl-b": "editor::ApplyRichTextBold",
      "ctrl-alt-e": "editor::ApplyRichTextEmphasis",
      "ctrl-alt-h": "editor::ApplyRichTextHeading",
      "ctrl-alt-r": "editor::ApplyRichTextRotated",
      "ctrl-f": "editor::OpenSearch",
      "ctrl-alt-[": "editor::SetPageBreakLeftOfCurrentColumn",
      "ctrl-alt-]": "editor::SetPageBreakRightOfCurrentColumn",
      "ctrl-alt-backspace": "editor::RemovePageBreakCurrentColumn"
    }
  },
  {
    "context": "SoukouTextInput && ruby_editor && !search_active",
    "bindings": {
      "enter": "editor::ApplyRubyEdit",
      "escape": "editor::CancelRubyEdit"
    }
  },
  {
    "context": "active_modal",
    "bindings": {
      "enter": "soukou::OpenModalPrimary",
      "escape": "soukou::DismissActiveModal"
    }
  },
  {
    "context": "epub_meta_form",
    "bindings": {
      "enter": "soukou::ConfirmEpubMeta",
      "escape": "soukou::DismissEpubMetaForm"
    }
  },
  {
    "context": "page_break_menu",
    "bindings": {
      "left": "editor::SetPageBreakLeftOfCurrentColumn",
      "right": "editor::SetPageBreakRightOfCurrentColumn",
      "backspace": "editor::RemovePageBreakCurrentColumn",
      "delete": "editor::RemovePageBreakCurrentColumn",
      "escape": "editor::DismissPageBreakMenu"
    }
  },
  {
    "context": "Settings",
    "bindings": {
      "1": "settings::ShowGeneralSettings",
      "2": "settings::ShowEditorSettings",
      "g": "settings::ToggleGridLines",
      "v": "settings::ToggleVimMode",
      "i": "settings::ToggleIndentOnEnter",
      "h": "settings::ToggleHangingPunctuation",
      "-": "settings::DecrementCellSize",
      "=": "settings::IncrementCellSize",
      "0": "settings::SetColumnNumberHidden",
      "5": "settings::SetColumnNumberEveryFive",
      "t": "settings::SetColumnNumberEveryTen",
      "a": "settings::SetColumnNumberAll"
    }
  },
  {
    "context": "search_active",
    "bindings": {
      "enter": "editor::FindNext",
      "shift-enter": "editor::FindPrevious",
      "ctrl-g": "editor::FindNext",
      "shift-ctrl-g": "editor::FindPrevious",
      "escape": "editor::CloseSearch"
    }
  },
  {
    "context": "vim_mode == insert || vim_mode == disabled",
    "bindings": {
      "backspace": "soukou::Backspace",
      "delete": "soukou::Delete",
      "up": "soukou::Up",
      "down": "soukou::Down",
      "left": "soukou::Left",
      "right": "soukou::Right",
      "shift-up": "soukou::SelectUp",
      "shift-down": "soukou::SelectDown",
      "shift-left": "soukou::SelectLeft",
      "shift-right": "soukou::SelectRight",
      "ctrl-a": "soukou::SelectAll",
      "ctrl-v": "soukou::Paste",
      "ctrl-c": "soukou::Copy",
      "ctrl-x": "soukou::Cut",
      "ctrl-z": "soukou::Undo",
      "ctrl-u": "soukou::Redo",
      "ctrl-y": "soukou::Redo",
      "enter": "soukou::Enter",
      "escape": "soukou::ClearSelection",
      "home": "soukou::Home",
      "end": "soukou::End"
    }
  },
  {
    "context": "vim_mode == normal",
    "bindings": {
      "i": "vim::VimEnterInsertMode",
      "a": "vim::VimAppend",
      "v": "vim::VimVisualMode",
      "ctrl-v": "vim::VimVisualBlockMode",
      "p": "vim::VimPasteAfter",
      "P": "vim::VimPasteBefore",
      "u": "vim::VimUndo",
      "ctrl-r": "vim::VimRedo",
      "ctrl-d": "vim::VimMoveHalfPageDown",
      "ctrl-u": "vim::VimMoveHalfPageUp",
      ".": "vim::VimRepeatLastChange",
      "b": "vim::VimMoveWordBackward",
      "B": "vim::VimMoveBigWordBackward",
      "g g": "vim::VimMoveDocumentStart",
      "G": "vim::VimMoveDocumentEnd",
      "o": "vim::VimOpenNextColumn"
    }
  },
  {
    "context": "vim_mode == normal || vim_mode == visual || vim_mode == visual_block",
    "bindings": {
      "d": "vim::VimDeleteOperator",
      "c": "vim::VimChangeOperator",
      "y": "vim::VimYankOperator",
      "w": "vim::VimMoveWordForward",
      "W": "vim::VimMoveBigWordForward",
      "e": "vim::VimMoveWordEndForward",
      "h": "vim::VimMoveLeft",
      "j": "vim::VimMoveDown",
      "k": "vim::VimMoveUp",
      "l": "vim::VimMoveRight",
      "x": "vim::VimDeleteChar"
    }
  },
  {
    "context": "vim_mode == visual",
    "bindings": {
      "v": "vim::VimNormalMode"
    }
  },
  {
    "context": "vim_mode == visual_block",
    "bindings": {
      "ctrl-v": "vim::VimNormalMode",
      "I": "vim::VimBlockInsertBefore",
      "A": "vim::VimBlockAppendAfter"
    }
  },
  {
    "context": "vim_mode == visual || vim_mode == visual_block",
    "bindings": {
      "g g": "vim::VimMoveDocumentStart",
      "G": "vim::VimMoveDocumentEnd"
    }
  },
  {
    "context": "vim_mode == insert || vim_mode == visual || vim_mode == visual_block || vim_mode == operator_delete || vim_mode == operator_change || vim_mode == operator_yank || vim_mode == operator_delete_inner || vim_mode == operator_delete_around || vim_mode == operator_change_inner || vim_mode == operator_change_around || vim_mode == operator_yank_inner || vim_mode == operator_yank_around",
    "bindings": {
      "escape": "vim::VimNormalMode"
    }
  },
  {
    "context": "vim_mode == operator_delete",
    "bindings": {
      "d": "vim::VimDeleteOperator"
    }
  },
  {
    "context": "vim_mode == operator_change",
    "bindings": {
      "c": "vim::VimChangeOperator"
    }
  },
  {
    "context": "vim_mode == operator_yank",
    "bindings": {
      "y": "vim::VimYankOperator"
    }
  },
  {
    "context": "vim_mode == operator_delete || vim_mode == operator_change || vim_mode == operator_yank",
    "bindings": {
      "w": "vim::VimMoveWordForward",
      "W": "vim::VimMoveBigWordForward",
      "e": "vim::VimMoveWordEndForward",
      "i": "vim::VimTextObjectInner",
      "a": "vim::VimTextObjectAround"
    }
  },
  {
    "context": "vim_mode == operator_delete_inner || vim_mode == operator_delete_around || vim_mode == operator_change_inner || vim_mode == operator_change_around || vim_mode == operator_yank_inner || vim_mode == operator_yank_around",
    "bindings": {
      "w": "vim::VimTextObjectWord",
      "W": "vim::VimTextObjectBigWord",
      "\"": "vim::VimTextObjectDoubleQuote",
      "'": "vim::VimTextObjectSingleQuote",
      "(": "vim::VimTextObjectParen",
      "[": "vim::VimTextObjectBracket"
    }
  }
]
